gap 50 50 50 50
command st st
command gimp gimp
command scrot scrot
command www firefox
command pavu pavucontrol
unbind-key all
# --- #
bind-key 4-q "st -g 42x20" 
bind-key 4-a firefox
# --- #
bind-key 4-d menu-cmd
bind-key 4S-d menu-exec
bind-key 4-x window-close
bind-key 4S-m quit
bind-key 4-m restart
bind-key 4-f window-maximize
# --- #
bind-mouse 4-1 window-move
bind-mouse 4-3 window-resize
# --- #
bind-key 4-Left window-snap-left
bind-key 4-c window-snap-center
bind-key 4-Up window-snap-up
bind-key 4-Right window-snap-right
bind-key 4S-Right window-hmaximize
bind-key 4-Down window-snap-down
bind-key 4S-Up window-vmaximize

bind-key 4-Tab 	  window-cycle
bind-key 4S-Tab	  window-rcycle
# --- #
borderwidth 4
color activeborder "#3d633b"
color inactiveborder "#3d633b"
# --- #
color menubg "#F5F5F5"
color menufg "#3d633b"
color font "#000000"
fontname "Libertinus Mono:pixelsize=16:style=Bold"

####

bind-key 4-h group-only-1
bind-key 4-j group-only-2
bind-key 4S-h window-movetogroup-1
bind-key 4S-j window-movetogroup-2
